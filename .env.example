# Copia este archivo como .env y define la conexión de Supabase.
# No subas el archivo .env ni la contraseña a Git.
DATABASE_URL=postgresql://postgres:TU_CONTRASENA@db.TU_PROYECTO.supabase.co:5432/postgres

# Web Push: genera las claves VAPID y guarda la privada sólo en Render.
VAPID_PUBLIC_KEY=TU_CLAVE_PUBLICA_VAPID
VAPID_PRIVATE_KEY=TU_CLAVE_PRIVADA_VAPID
VAPID_SUBJECT=mailto:tu-correo@example.com
CRON_SECRET=UN_SECRETO_LARGO_Y_ALEATORIO
APP_TIMEZONE=America/Bogota